# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the web player (no trailing slash). Used to build personal links sent in WhatsApp.
APP_URL=http://localhost:3000

# Which tenant (brand) this deployment serves. Matches tenants.slug in the database.
TENANT_SLUG=watchat

# --- Supabase (Project Settings → API) ---
# If you link Supabase through Vercel → Integrations, these are set for you as
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY — the app accepts either naming.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only key (secret key "sb_secret_…" or legacy service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ---
# Phone number ID of the test number (later: your real business number).
WHATSAPP_PHONE_NUMBER_ID=
# Temporary token for testing; use a System User token in production.
WHATSAPP_ACCESS_TOKEN=
# App secret (App settings → Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in the webhook setup screen.
WHATSAPP_VERIFY_TOKEN=
# Graph API version to call.
WHATSAPP_GRAPH_VERSION=v23.0
# The business number viewers chat with, digits only (used for wa.me links), e.g. 9715XXXXXXXX
WHATSAPP_DISPLAY_NUMBER=
# --- Telegram (optional second channel) ---
# Bot token from @BotFather. With it set, Admin → Settings → Brand & site → Telegram connects the bot.
TELEGRAM_BOT_TOKEN=

# "Messaging account ID" (WhatsApp Business Account ID) — needed to submit and sync templates from the admin.
WHATSAPP_WABA_ID=

# --- Security ---
# Long random string used to hash phone numbers for analytics (openssl rand -hex 32).
PHONE_HASH_SECRET=

# --- Cloudflare Stream (web video) ---
# The "customer-xxxx" code from your Stream dashboard, without the "customer-" prefix.
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# --- Cloudflare Stream uploads from the admin (Cloudflare dashboard → Stream → API token with Stream:Edit) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Payments: Tap (dashboard → goSell → API credentials). Use the test key (sk_test_…) until launch. ---
TAP_SECRET_KEY=

# --- Admin ---
# One-time token to create the first owner account at /admin/setup (any 32+ random characters).
ADMIN_SETUP_TOKEN=

# --- Scheduled messaging (sequences + campaigns run every 15 min). Vercel sends it as a Bearer token. ---
CRON_SECRET=

# --- AI scenario agent: encrypts each label's AI API key in the database (32+ random characters).
# Each label pastes its own Anthropic API key in Admin → AI account; it is never shown again.
SETTINGS_ENCRYPTION_KEY=
